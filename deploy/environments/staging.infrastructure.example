# Non-secret staging infrastructure configuration.
# Copy outside the repository or pass directly with docker compose --env-file.

SUQNAA_POSTGRES_DB=suqnaa_staging
SUQNAA_POSTGRES_USER=suqnaa
SUQNAA_APPLICATION_NETWORK=suqnaa-staging-application
SUQNAA_EDGE_NETWORK=suqnaa-staging-edge
SUQNAA_SECRET_DIR=/etc/suqnaa/staging/secrets

SUQNAA_WEB_DOMAIN=staging.example.invalid
SUQNAA_API_DOMAIN=api.staging.example.invalid
SUQNAA_ACME_EMAIL=ops@example.invalid
SUQNAA_WEB_UPSTREAM=web:3000
SUQNAA_API_UPSTREAM=api:4000

# Encrypted backups and staging restore drill.
SUQNAA_BACKUP_S3_BUCKETS=suqnaa-staging-media
SUQNAA_BACKUP_INTERVAL_SECONDS=86400
SUQNAA_BACKUP_STARTUP_DELAY_SECONDS=30
SUQNAA_BACKUP_RETENTION_DAYS=14
SUQNAA_RESTORE_ENVIRONMENT=staging
SUQNAA_RESTORE_CLEAR_OBJECT_STORAGE=true
