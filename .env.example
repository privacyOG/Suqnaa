# Runtime
NODE_ENV=development

# API service
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Web-to-API URLs
# NEXT_PUBLIC_API_BASE_URL is used by browser-side requests.
# API_BASE_URL is used by server-side web routes when available.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
API_BASE_URL=http://localhost:4000

# Data stores
DATABASE_URL=postgres://suqnaa:suqnaa_dev_password@localhost:5432/suqnaa
REDIS_URL=redis://localhost:6379

# Listing lifecycle worker
# Active listings expire automatically. Renewals are allowed only inside the renewal window.
# Accepted offers without an order keep an inventory reservation for a bounded period.
LISTING_ACTIVE_DAYS=30
LISTING_RENEWAL_WINDOW_DAYS=7
LISTING_RESERVATION_MINUTES=60
LISTING_LIFECYCLE_BATCH_SIZE=100
LISTING_LIFECYCLE_INTERVAL_SECONDS=60

# Discovery and saved-search notification worker
# Saved-search matching is delivered to the in-app notification store in this phase.
DISCOVERY_NOTIFICATION_INTERVAL_SECONDS=60
DISCOVERY_NOTIFICATION_SEARCH_BATCH_SIZE=50
DISCOVERY_NOTIFICATION_MATCH_BATCH_SIZE=100
RECENTLY_VIEWED_LIMIT=100
SAVED_LISTING_LIMIT=500
WATCHLIST_LIMIT=200
SAVED_SEARCH_LIMIT=50

# Security secrets - replace with long random production values and keep out of source control.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-secret
PASSWORD_PEPPER=replace-with-a-long-random-secret
PASSWORD_RESET_PEPPER=replace-with-a-separate-long-random-secret
VERIFICATION_CODE_PEPPER=replace-with-another-separate-long-random-secret

# Account security delivery
# console is for local development only. Production requires http.
# Contact verification sends purpose, channel, destination, code, and expiresAt.
# Password reset sends purpose, channel, destination, token, and expiresAt.
VERIFICATION_DELIVERY_PROVIDER=console
VERIFICATION_DELIVERY_URL=
VERIFICATION_DELIVERY_TOKEN=
VERIFICATION_DELIVERY_TIMEOUT_MS=5000

# Seller identity/business verification - disabled until an approved provider is configured.
# The provider endpoint creates or resumes hosted verification sessions.
# Provider-result events are independently HMAC signed and never auto-approve a seller.
SELLER_VERIFICATION_PROVIDER=none
SELLER_VERIFICATION_URL=
SELLER_VERIFICATION_TOKEN=
SELLER_VERIFICATION_SIGNING_SECRET=
SELLER_VERIFICATION_TIMEOUT_MS=5000
SELLER_VERIFICATION_EVENT_MAX_AGE_SECONDS=300
SELLER_VERIFICATION_VALID_DAYS=365

# Object storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=suqnaa-local
S3_ACCESS_KEY=suqnaa
S3_SECRET_KEY=suqnaa_dev_password

# Human challenge provider
CHALLENGE_PROVIDER=none
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_TIMEOUT_MS=5000
NEXT_PUBLIC_CHALLENGE_SCRIPT_URL=

# Signed payment-provider events - disabled until a provider and compliance controls are approved.
PAYMENT_EVENT_PROVIDER=none
PAYMENT_EVENT_SIGNING_SECRET=
PAYMENT_EVENT_MAX_AGE_SECONDS=300
