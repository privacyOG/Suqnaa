# Runtime
NODE_ENV=development

# API service
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Web-to-API URLs
# NEXT_PUBLIC_API_BASE_URL is used by browser-side requests.
# API_BASE_URL is used by server-side web routes when available.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
API_BASE_URL=http://localhost:4000

# Data stores
DATABASE_URL=postgres://suqnaa:suqnaa_dev_password@localhost:5432/suqnaa
REDIS_URL=redis://localhost:6379

# Listing lifecycle worker
# Active listings expire automatically. Renewals are allowed only inside the renewal window.
# Accepted offers without an order keep an inventory reservation for a bounded period.
LISTING_ACTIVE_DAYS=30
LISTING_RENEWAL_WINDOW_DAYS=7
LISTING_RESERVATION_MINUTES=60
LISTING_LIFECYCLE_BATCH_SIZE=100
LISTING_LIFECYCLE_INTERVAL_SECONDS=60

# Discovery and saved-search notification worker
# Saved-search matching is delivered to the protected discovery notification store.
DISCOVERY_NOTIFICATION_INTERVAL_SECONDS=60
DISCOVERY_NOTIFICATION_SEARCH_BATCH_SIZE=50
DISCOVERY_NOTIFICATION_MATCH_BATCH_SIZE=100
RECENTLY_VIEWED_LIMIT=100
SAVED_LISTING_LIMIT=500
WATCHLIST_LIMIT=200
SAVED_SEARCH_LIMIT=50

# Durable marketplace/account notification delivery.
# Outbound providers are disabled until an approved HTTPS gateway is configured per channel.
# The gateway receives a provider-neutral marketplace_notification JSON contract and an Idempotency-Key header.
NOTIFICATION_EMAIL_PROVIDER=disabled
NOTIFICATION_EMAIL_URL=
NOTIFICATION_EMAIL_TOKEN=
NOTIFICATION_SMS_PROVIDER=disabled
NOTIFICATION_SMS_URL=
NOTIFICATION_SMS_TOKEN=
NOTIFICATION_PUSH_PROVIDER=disabled
NOTIFICATION_PUSH_URL=
NOTIFICATION_PUSH_TOKEN=
NOTIFICATION_PROVIDER_TIMEOUT_MS=5000
NOTIFICATION_WORKER_INTERVAL_MS=5000
NOTIFICATION_WORKER_BATCH_SIZE=50
NOTIFICATION_DELIVERY_LOCK_TIMEOUT_MS=300000
NOTIFICATION_DELIVERY_MAX_ATTEMPTS=8

# Security secrets - replace with long random production values and keep out of source control.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-secret
PASSWORD_PEPPER=replace-with-a-long-random-secret
PASSWORD_RESET_PEPPER=replace-with-a-separate-long-random-secret
VERIFICATION_CODE_PEPPER=replace-with-another-separate-long-random-secret

# Account security delivery
# console is for local development only. Production requires http.
# Contact verification sends purpose, channel, destination, code, and expiresAt.
# Password reset sends purpose, channel, destination, token, and expiresAt.
VERIFICATION_DELIVERY_PROVIDER=console
VERIFICATION_DELIVERY_URL=
VERIFICATION_DELIVERY_TOKEN=
VERIFICATION_DELIVERY_TIMEOUT_MS=5000

# Seller identity/business verification - disabled until an approved provider is configured.
# The provider endpoint creates or resumes hosted verification sessions.
# Provider-result events are independently HMAC signed and never auto-approve a seller.
SELLER_VERIFICATION_PROVIDER=none
SELLER_VERIFICATION_URL=
SELLER_VERIFICATION_TOKEN=
SELLER_VERIFICATION_SIGNING_SECRET=
SELLER_VERIFICATION_TIMEOUT_MS=5000
SELLER_VERIFICATION_EVENT_MAX_AGE_SECONDS=300
SELLER_VERIFICATION_VALID_DAYS=365

# Object storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=suqnaa-local
S3_ACCESS_KEY=suqnaa
S3_SECRET_KEY=suqnaa_dev_password

# Human challenge provider
CHALLENGE_PROVIDER=none
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_TIMEOUT_MS=5000
NEXT_PUBLIC_CHALLENGE_SCRIPT_URL=

# Signed provider-neutral payment events retained for non-Stripe integrations.
PAYMENT_EVENT_PROVIDER=none
PAYMENT_EVENT_SIGNING_SECRET=
PAYMENT_EVENT_MAX_AGE_SECONDS=300

# Buyer payment collection through Stripe-hosted Checkout.
# Disabled by default. Test keys enable test-mode collection only.
# Live secret keys are rejected unless NODE_ENV=production and PAYMENT_COLLECTION_LIVE_APPROVED=true.
# PAYMENT_COLLECTION_WEB_ORIGIN is used only to build trusted Checkout return URLs and defaults to WEB_ORIGIN.
PAYMENT_COLLECTION_PROVIDER=none
PAYMENT_COLLECTION_WEB_ORIGIN=http://localhost:3000
PAYMENT_COLLECTION_TIMEOUT_MS=8000
PAYMENT_COLLECTION_LIVE_APPROVED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Seller onboarding, settlement, and payout controls.
# Disabled by default. Enabling requires an explicit commission, release-to-transfer delay,
# payout schedule, and a distinct Connect webhook secret. Live seller transfers remain blocked
# until SELLER_SETTLEMENT_LIVE_APPROVED=true in addition to the buyer-payment live approval above.
# Seller bank/KYC details are collected and stored by the provider-hosted onboarding flow, not Suqnaa.
SELLER_SETTLEMENT_ENABLED=false
SELLER_SETTLEMENT_LIVE_APPROVED=false
SELLER_SETTLEMENT_COMMISSION_BPS=0
SELLER_SETTLEMENT_DELAY_DAYS=0
SELLER_SETTLEMENT_PAYOUT_INTERVAL=weekly
SELLER_SETTLEMENT_PAYOUT_ANCHOR=monday
SELLER_SETTLEMENT_WORKER_BATCH_SIZE=50
SELLER_SETTLEMENT_WORKER_INTERVAL_MS=15000
STRIPE_CONNECT_WEBHOOK_SECRET=
